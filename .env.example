# Optional — enables Groq's free hosted tier (console.groq.com/keys, no
# credit card). Without it both tools go straight to their local, keyless
# fallback, so the server still works with no key at all.
GROQ_API_KEY=

# Optional — where generated audio files are written. Defaults to
# ./output under the process's current working directory.
# VOICE_IO_OUTPUT_DIR=
